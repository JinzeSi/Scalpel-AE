SET profiling=1;
EXPLAIN ANALYZE
select  
  coalesce(ref_0.name,
    ref_0.name) as c0, 
  coalesce(coalesce(ref_0.user_id,
      ref_0.id),
    ref_0.id) as c2, 
  1
from 
  test_bd.locations as ref_0
where (((EXISTS (
        select  
            1
          from 
            test_bd.posts as ref_1
              right join test_bd.user_profiles as ref_2
              on (true)
          where false)) 
      or (ref_0.coordinates is not NULL)) 
    and (EXISTS (
      select  
          1
        from 
          test_bd.posts as ref_3
        where ((ref_0.coordinates is not NULL) 
            and (ref_3.id is not NULL)) 
          or (((EXISTS (
                select  
                    1
                  from 
                    test_bd.locations as ref_4
                  where ref_3.content is NULL)) 
              and (ref_0.user_id is not NULL)) 
            and (true))
        ))) 
  and (ref_0.coordinates is not NULL)
;
SHOW profiles;
