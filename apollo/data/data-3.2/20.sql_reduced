SET profiling=1;
EXPLAIN ANALYZE
select  
  1
from 
  test_bd.user_profiles as ref_0
where EXISTS (
  select  
      1
    from 
      test_bd.user_post_comments as ref_1
    where EXISTS (
      select  
          1
        from 
          test_bd.comments as ref_2
        where ref_2.id is not NULL)
    );
SHOW profiles;
