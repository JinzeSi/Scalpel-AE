SET profiling=1;
EXPLAIN ANALYZE
select  
  1
from 
  (select  
          1
        from 
          test_bd.user_profiles as ref_0
        where (ref_0.profile_picture is NULL) 
          and (EXISTS (
            select  
                1
              from 
                test_bd.eids as ref_1
              where ((EXISTS (
                    select  
                        1
                      from 
                        test_bd.posts as ref_2,
                        lateral (select  
                              1
                            from 
                              test_bd.posts as ref_3,
                              lateral (select  
                                    ref_1.id as c0, 
                                    ref_0.birthdate as c1, 
                                    (select eid from test_bd.eids limit 1 offset 4) as c3,
                                    1
                                  from 
                                    test_bd.comments as ref_4
                                  where false
                                  ) as subq_0
                            where EXISTS (
                              select  
                                  1
                                from 
                                  test_bd.user_post_comments as ref_5
                                where (false) 
                                  and ((true) 
                                    and (true))
                                )
                            ) as subq_1
                      where false)) 
                  or ((EXISTS (
                      select  
                          1
                        from 
                          test_bd.users as ref_6
                        where true)) 
                    or (true))) 
                and (EXISTS (
                  select  
                      1, 
                      1
                    from 
                      test_bd.employee as ref_7
                    where (((true) 
                          and (ref_1.id is NULL)) 
                        and (false)) 
                      and ((true) 
                        or ((((false) 
                              and (ref_0.profile_picture is NULL)) 
                            or (false)) 
                          or (ref_0.bio is not NULL)))
                    ))
              ))) as subq_2
    right join (select  
            subq_3.c2 as c2, 
            ref_8.bio as c4, 
            ref_8.birthdate as c14, 
            subq_3.c2 as c15, 
            1
          from 
            test_bd.user_profiles as ref_8,
            lateral (select  
                  ref_8.bio as c0, 
                  ref_8.birthdate as c1, 
                  ref_9.department_id as c2, 
                  ref_8.birthdate as c3, 
                  ref_8.birthdate as c4
                from 
                  test_bd.employee as ref_9
                where true
                ) as subq_3,
            lateral (select  
                  ref_8.user_id as c0, 
                  ref_10.comment as c1, 
                  ref_8.profile_picture as c3, 
                  subq_3.c1 as c4
                from 
                  test_bd.user_post_comments as ref_10
                where (ref_8.user_id is not NULL) 
                  and (false)
                ) as subq_4
          where (((subq_3.c0 is not NULL) 
                and (subq_4.c0 is not NULL)) 
              and ((true) 
                and ((false) 
                  or ((subq_4.c3 is not NULL) 
                    and (true))))) 
            or (false)
          ) as subq_5
      left join test_bd.users as ref_11
      on (EXISTS (
          select distinct 
              1 as c1, 
              1
            from 
              test_bd.posts as ref_12
            where ref_11.id is NULL
            ))
    on (ref_11.id is not NULL)
where ref_11.username is NULL
;
SHOW profiles;
